---
// src/pages/index.astro
import StudioLayout from '../layouts/StudioLayout.astro';
import WallpaperCard from '../components/WallpaperCard.astro';
import { wallpapers as wallpapersBrand } from '../data/wallpapers-brand';
import { wallpapers as pcWallpapers } from '../data/wallpapers';

const ALL_PINS_URL = 'https://co.pinterest.com/arevaloalfredo69/pins/';

// SEO para Google y Bing
const siteUrl = 'https://studio.veyxara.com';
const canonicalUrl = `${siteUrl}/`;
const seoTitle = 'Veyxara Studio | Arte Digital, Wallpapers y Colecciones Visuales';
const seoDescription =
  'Vitrina creativa de arte generado con IA, fondos de pantalla en alta definición para PC y colecciones visuales de Veyxara Studio.';
const seoImage = `${siteUrl}/hero-studio.webp`;

const totalPieces = wallpapersBrand.length + pcWallpapers.length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: canonicalUrl,
      name: 'Veyxara Studio',
      description: seoDescription,
      inLanguage: 'es',
    },
    {
      '@type': 'CollectionPage',
      '@id': `${siteUrl}/#collectionpage`,
      url: canonicalUrl,
      name: seoTitle,
      description: seoDescription,
      isPartOf: { '@id': `${siteUrl}/#website` },
      primaryImageOfPage: {
        '@type': 'ImageObject',
        url: seoImage,
        width: 1920,
        height: 1080,
      },
      mainEntity: { '@id': `${siteUrl}/#gallery` },
    },
    {
      '@type': 'ImageGallery',
      '@id': `${siteUrl}/#gallery`,
      url: canonicalUrl,
      name: 'Colecciones de Arte Digital y Wallpapers — Veyxara Studio',
      description: seoDescription,
      numberOfItems: totalPieces,
    },
  ],
};

const studioSectionTheme = {
  pageBg: 'bg-[#FAF6EE]',
  sectionBg: 'bg-[#F3E8D2]',
  sectionBorder: 'border-[#B45309]/25',
  dividerBorder: 'border-[#B45309]/20',
  headingInk: 'text-[#1C1917]',
  bodyInk: 'text-[#44403C]',
  accentText: 'text-[#B45309]',
  accentDeep: 'text-[#92400E]',
  pillBg: 'bg-[#EEDBBE]',
  pillBorder: 'border-[#B45309]/40',
  pillText: 'text-[#78350F]',
  emptyCard: 'bg-[#FFFDF9] border-[#B45309]/30 text-[#44403C]',
};
---

<StudioLayout title={seoTitle} description={seoDescription}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />
    <meta
      name="googlebot"
      content="index, follow, max-image-preview:large, max-snippet:-1"
    />
    <meta name="bingbot" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Veyxara Studio" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={seoImage} />
    <meta
      property="og:image:alt"
      content="Arte digital, wallpapers y colecciones visuales de Veyxara Studio"
    />
    <meta property="og:image:width" content="1920" />
    <meta property="og:image:height" content="1080" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>

  <main class:list={['relative overflow-hidden', studioSectionTheme.pageBg]}>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-16">
      <!-- HERO CENTRAL PANORÁMICO -->
      <section aria-labelledby="hero-heading" class="mb-16">
        <div class="relative overflow-hidden rounded-3xl bg-[#071426] shadow-xl">
          <img
            src="/hero-studio.webp"
            alt="Arte digital, wallpapers y colecciones visuales de Veyxara Studio"
            width="1920"
            height="1080"
            fetchpriority="high"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-[22%_center] md:object-center"
          />

          <div
            class="absolute inset-0 bg-gradient-to-r from-[#071426]/95 via-[#071426]/80 to-[#071426]/35 md:hidden"
            aria-hidden="true"
          ></div>

          <div class="relative z-10 flex min-h-[420px] flex-col justify-center px-6 py-12 sm:px-12 lg:min-h-[480px] lg:max-w-2xl lg:px-16">
            <span class="mb-5 inline-flex w-fit items-center gap-2 rounded-full border border-[#E8EEF5]/25 bg-[#071426]/70 px-4 py-1.5 text-[11px] font-semibold tracking-[0.14em] text-[#E8EEF5] uppercase">
              <span class="text-[#FF9900]" aria-hidden="true">✦</span>
              Arte Digital · Wallpapers · Colecciones Visuales
            </span>

            <h1
              id="hero-heading"
              class="text-3xl leading-[1.12] font-extrabold tracking-tight text-[#E8EEF5] sm:text-5xl lg:text-[3.25rem]"
              style="font-family: 'Orbitron', sans-serif;"
            >
              Mundos, mitos y escenas con{' '}
              <span class="text-[#FF9900]">fuerza y color</span>
            </h1>

            <p class="mt-5 max-w-xl text-base leading-relaxed text-[#E8EEF5]/90 sm:text-lg">
              Vitrina creativa de arte generado con IA, fondos de pantalla en alta
              definición para PC y colecciones visuales de Veyxara Studio.
            </p>

            <div class="mt-8 flex flex-wrap items-center gap-3">
              <a
                href="#pc-wallpapers"
                class="inline-flex items-center justify-center rounded-xl bg-[#FF9900] px-5 py-3 text-sm font-bold text-[#071426] shadow-sm transition-colors hover:bg-[#FFB03A]"
              >
                Explorar Wallpapers PC
              </a>

              <a
                href="#pinterest-gallery"
                class="inline-flex items-center justify-center rounded-xl border border-[#E8EEF5]/30 bg-[#FFFDF9] px-5 py-3 text-sm font-semibold text-[#1C1917] shadow-sm transition-colors hover:bg-[#F3E8D2]"
              >
                Ver Más Imágenes
              </a>
            </div>
          </div>
        </div>
      </section>

      <div id="colecciones" class="space-y-16">
        <!-- 1. MANEJO DE MARCA (SOLO VISUALIZACIÓN) -->
        {wallpapersBrand.length > 0 && (
          <section
            aria-labelledby="brand-heading"
            class:list={[
              'rounded-3xl border p-6 sm:p-8',
              studioSectionTheme.sectionBg,
              studioSectionTheme.sectionBorder,
            ]}
          >
            <div
              class:list={[
                'border-b pb-4 mb-8 flex items-center justify-between gap-4',
                studioSectionTheme.dividerBorder,
              ]}
            >
              <div>
                <h2
                  id="brand-heading"
                  class:list={['text-xl sm:text-2xl font-bold', studioSectionTheme.headingInk]}
                  style="font-family: 'Orbitron', sans-serif;"
                >
                  Manejo de Marca &amp;{' '}
                  <span class={studioSectionTheme.accentDeep}>Arte Insignia</span>
                </h2>
                <p class:list={['text-xs sm:text-sm mt-1', studioSectionTheme.bodyInk]}>
                  Piezas visuales de identidad de marca disponibles para inspección (sin descarga).
                </p>
              </div>
              <span
                class:list={[
                  'text-xs font-bold px-3 py-1 rounded-full border whitespace-nowrap shrink-0',
                  studioSectionTheme.pillBg,
                  studioSectionTheme.pillBorder,
                  studioSectionTheme.pillText,
                ]}
              >
                {wallpapersBrand.length} piezas
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
              {wallpapersBrand.map((wallpaper, idx) => (
                <WallpaperCard wallpaper={wallpaper} index={idx} />
              ))}
            </div>
          </section>
        )}

        <!-- 2. FONDOS PC LOCALES (CON DESCARGA DIRECTA) -->
        <section
          id="pc-wallpapers"
          aria-labelledby="pc-wallpapers-heading"
          class:list={[
            'rounded-3xl border p-6 sm:p-8',
            studioSectionTheme.sectionBg,
            studioSectionTheme.sectionBorder,
          ]}
        >
          <div
            class:list={[
              'border-b pb-4 mb-8 flex items-center justify-between gap-4',
              studioSectionTheme.dividerBorder,
            ]}
          >
            <div>
              <h2
                id="pc-wallpapers-heading"
                class:list={['text-xl sm:text-2xl font-bold', studioSectionTheme.headingInk]}
                style="font-family: 'Orbitron', sans-serif;"
              >
                Fondos de Escritorio{' '}
                <span class={studioSectionTheme.accentText}>(PC)</span>
              </h2>
              <p class:list={['text-xs sm:text-sm mt-1', studioSectionTheme.bodyInk]}>
                Fondos locales listos para ampliar y descargar en alta calidad.
              </p>
            </div>
            <span
              class:list={[
                'text-xs font-bold px-3 py-1 rounded-full border whitespace-nowrap shrink-0',
                studioSectionTheme.pillBg,
                studioSectionTheme.pillBorder,
                studioSectionTheme.pillText,
              ]}
            >
              {pcWallpapers.length} piezas
            </span>
          </div>

          {pcWallpapers.length > 0 ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
              {pcWallpapers.map((wallpaper, idx) => (
                <WallpaperCard wallpaper={wallpaper} index={1000 + idx} />
              ))}
            </div>
          ) : (
            <div class:list={['rounded-xl border p-10 text-center text-sm', studioSectionTheme.emptyCard]}>
              Agrega tus fondos de escritorio en{' '}
              <code class={studioSectionTheme.accentText}>src/data/wallpapers.ts</code>.
            </div>
          )}
        </section>

        <!-- 3. ARCHIVO COMPLETO DE IMÁGENES (TODOS LOS PINES) -->
        <section
          id="pinterest-gallery"
          aria-labelledby="pinterest-heading"
          class:list={[
            'rounded-3xl border p-6 sm:p-8',
            studioSectionTheme.sectionBg,
            studioSectionTheme.sectionBorder,
          ]}
        >
          <div
            class:list={[
              'border-b pb-4 mb-6 flex items-center justify-between gap-4',
              studioSectionTheme.dividerBorder,
            ]}
          >
            <div>
              <h2
                id="pinterest-heading"
                class:list={['text-xl sm:text-2xl font-bold', studioSectionTheme.headingInk]}
                style="font-family: 'Orbitron', sans-serif;"
              >
                Archivo Completo{' '}
                <span class={studioSectionTheme.accentText}>(+100 Imágenes)</span>
              </h2>
              <p class:list={['text-xs sm:text-sm mt-1', studioSectionTheme.bodyInk]}>
                Para ver todo el catálogo de piezas y no quedarte solo con una muestra recortada, entra directamente a la vista de todos los pines.
              </p>
            </div>
            <span
              class:list={[
                'text-xs font-bold px-3 py-1 rounded-full border whitespace-nowrap shrink-0',
                studioSectionTheme.pillBg,
                studioSectionTheme.pillBorder,
                studioSectionTheme.pillText,
              ]}
            >
              +100 piezas
            </span>
          </div>

          <div
            class:list={[
              'rounded-2xl border p-8 sm:p-10 text-center flex flex-col items-center justify-center gap-4',
              studioSectionTheme.emptyCard,
            ]}
          >
            <p class:list={['max-w-xl text-sm sm:text-base leading-relaxed', studioSectionTheme.bodyInk]}>
              Aquí reunimos las piezas destacadas y fondos locales de escritorio. Si quieres explorar las más de 100 imágenes publicadas, revisa directamente la sección con todos los pines.
            </p>
            <a
              href={ALL_PINS_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center px-6 py-3 rounded-xl bg-[#B45309] text-sm font-bold text-[#FFFDF9] shadow-xs transition-colors hover:bg-[#92400E]"
            >
              Ver todas las imágenes (+100 pines) ↗
            </a>
          </div>
        </section>
      </div>
    </div>
  </main>
</StudioLayout>