---
// src/pages/index.astro
import StudioLayout from '../layouts/StudioLayout.astro';
import WallpaperCard from '../components/WallpaperCard.astro';
import type { Wallpaper } from '../components/WallpaperCard.astro';
import { wallpapers as wallpapersBrand } from '../data/wallpapers-brand';
import { wallpapers as pcWallpapers } from '../data/wallpapers';
import { PinterestRssService } from '../services/PinterestRssService';

// Solo el tablero de Veyxara Studio (sin tableros de Veyxara Core)
const PINTEREST_RSS_URLS = [
  'https://www.pinterest.com/arevaloalfredo69/veyxara-studio.rss',
];

const rssService = new PinterestRssService(PINTEREST_RSS_URLS);
const pinterestWallpapers: Wallpaper[] = await rssService.fetchWallpapers().catch(() => []);

const featuredPool: Wallpaper[] = [...wallpapersBrand, ...pcWallpapers, ...pinterestWallpapers];
const randomFeatured =
  featuredPool.length > 0
    ? featuredPool[Math.floor(Math.random() * featuredPool.length)]
    : null;
---

<StudioLayout>
  <main class="relative overflow-hidden bg-[#F6E7C6]">
    <!-- Resplandor cálido en ámbar intenso y oro -->
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -top-20 left-1/2 -translate-x-1/2 w-[940px] h-[400px] rounded-full blur-3xl opacity-45"
      style="background: radial-gradient(circle, rgba(255,153,0,0.48) 0%, rgba(217,119,6,0.25) 55%, transparent 100%);"
    ></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-12 pb-16">
      <!-- PORTADA VISUAL DE VEYXARA STUDIO -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center mb-20">
        <div class="lg:col-span-7 text-left">
          <span class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-[#78350F] px-3 py-1 rounded-full bg-[#FDE68A] border border-[#B45309]/45">
            ✦ Arte Digital · Wallpapers · Colecciones Visuales
          </span>

          <h1
            class="mt-4 text-3xl sm:text-5xl font-extrabold leading-tight text-[#1C1917]"
            style="font-family: 'Orbitron', sans-serif;"
          >
            Mundos, mitos y escenas con <span class="text-[#EA580C]">fuerza</span> y <span class="text-[#B45309]">color</span>
          </h1>

          <p class="mt-4 text-sm sm:text-base text-[#292524] leading-relaxed max-w-xl">
            Vitrina creativa de arte generado con IA, fondos de pantalla en alta definición para PC y piezas verticales sincronizadas desde el tablero de Veyxara Studio en Pinterest.
          </p>

          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href="#pc-wallpapers"
              class="px-5 py-2.5 rounded-xl bg-[#EA580C] text-white font-bold text-sm hover:bg-[#C2410C] transition-colors shadow-md shadow-[#EA580C]/25"
            >
              Explorar Wallpapers PC
            </a>
            <a
              href="#pinterest-gallery"
              class="px-5 py-2.5 rounded-xl bg-[#FFF8E7] border border-[#B45309]/55 text-[#78350F] font-bold text-sm hover:bg-[#FDE68A] transition-colors"
            >
              Ver Tablero Pinterest
            </a>
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="relative aspect-[16/10] w-full rounded-2xl overflow-hidden bg-[#FFF8E7] border-2 border-[#D97706]/60 shadow-xl shadow-[#78350F]/15">
            {randomFeatured ? (
              <>
                <img
                  src={randomFeatured.image}
                  alt={randomFeatured.title}
                  class="w-full h-full object-cover"
                />
                <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-[#1C1917]/95 via-[#1C1917]/65 to-transparent p-4">
                  <span class="text-[11px] font-semibold uppercase tracking-wider text-[#FBBF24]">
                    Destacado · {randomFeatured.category}
                  </span>
                  <p class="text-sm font-bold text-white truncate mt-0.5">
                    {randomFeatured.title}
                  </p>
                </div>
              </>
            ) : (
              <div class="h-full flex items-center justify-center text-xs text-[#57534E]">
                Agrega tus piezas en src/data/wallpapers.ts
              </div>
            )}
          </div>
        </div>
      </div>

      <div id="colecciones" class="space-y-20">
        <!-- 1. MANEJO DE MARCA (SOLO VISUALIZACIÓN) -->
        {wallpapersBrand.length > 0 && (
          <section class="rounded-3xl bg-[#EFE0BD]/70 border border-[#B45309]/25 p-6 sm:p-8">
            <div class="border-b border-[#B45309]/25 pb-4 mb-8 flex items-center justify-between gap-4">
              <div>
                <h2 class="text-xl sm:text-2xl font-bold text-[#1C1917]" style="font-family: 'Orbitron', sans-serif;">
                  Manejo de Marca & <span class="text-[#B45309]">Arte Insignia</span>
                </h2>
                <p class="text-xs sm:text-sm text-[#44403C] mt-1">
                  Piezas visuales de identidad de marca disponibles para inspección (sin descarga).
                </p>
              </div>
              <span class="text-xs font-bold px-3 py-1 rounded-full bg-[#FDE68A] border border-[#B45309]/45 text-[#78350F]">
                {wallpapersBrand.length} piezas
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
              {wallpapersBrand.map((wallpaper, idx) => (
                <WallpaperCard wallpaper={wallpaper} index={idx} />
              ))}
            </div>
          </section>
        )}

        <!-- 2. FONDOS PC LOCALES (CON DESCARGA DIRECTA) -->
        <section id="pc-wallpapers" class="rounded-3xl bg-[#EFE0BD]/70 border border-[#B45309]/25 p-6 sm:p-8">
          <div class="border-b border-[#B45309]/25 pb-4 mb-8 flex items-center justify-between gap-4">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-[#1C1917]" style="font-family: 'Orbitron', sans-serif;">
                Fondos de Escritorio <span class="text-[#EA580C]">(PC)</span>
              </h2>
              <p class="text-xs sm:text-sm text-[#44403C] mt-1">
                Fondos locales listos para ampliar y descargar en alta calidad.
              </p>
            </div>
            <span class="text-xs font-bold px-3 py-1 rounded-full bg-[#FDE68A] border border-[#B45309]/45 text-[#78350F]">
              {pcWallpapers.length} piezas
            </span>
          </div>

          {pcWallpapers.length > 0 ? (
            <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
              {pcWallpapers.map((wallpaper, idx) => (
                <WallpaperCard wallpaper={wallpaper} index={1000 + idx} />
              ))}
            </div>
          ) : (
            <div class="rounded-xl border border-[#B45309]/25 bg-[#FFF8E7] p-10 text-center text-sm text-[#44403C]">
              Agrega tus fondos de escritorio en <code class="text-[#C2410C]">src/data/wallpapers.ts</code>.
            </div>
          )}
        </section>

        <!-- 3. TABLERO DE PINTEREST DE VEYXARA STUDIO -->
        <section id="pinterest-gallery" class="rounded-3xl bg-[#EFE0BD]/70 border border-[#B45309]/25 p-6 sm:p-8">
          <div class="border-b border-[#B45309]/25 pb-4 mb-8 flex items-center justify-between gap-4">
            <div>
              <h2 class="text-xl sm:text-2xl font-bold text-[#1C1917]" style="font-family: 'Orbitron', sans-serif;">
                Tablero Veyxara Studio <span class="text-[#C2410C]">(Pinterest)</span>
              </h2>
              <p class="text-xs sm:text-sm text-[#44403C] mt-1">
                Piezas sincronizadas desde el tablero de Veyxara Studio en Pinterest.
              </p>
            </div>
            <span class="text-xs font-bold px-3 py-1 rounded-full bg-[#FDE68A] border border-[#B45309]/45 text-[#78350F]">
              {pinterestWallpapers.length} pines
            </span>
          </div>

          {pinterestWallpapers.length > 0 ? (
            <>
              <div id="pinterest-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                {pinterestWallpapers.map((wallpaper, idx) => (
                  <div class={`pinterest-block-item ${idx >= 12 ? 'hidden' : ''}`}>
                    <WallpaperCard wallpaper={wallpaper} index={2000 + idx} />
                  </div>
                ))}
              </div>

              {pinterestWallpapers.length > 12 && (
                <div class="mt-10 flex justify-center">
                  <button
                    id="load-more-pinterest-btn"
                    type="button"
                    class="px-6 py-2.5 rounded-xl bg-[#FFF8E7] border border-[#B45309]/55 text-[#78350F] text-sm font-bold hover:bg-[#EA580C] hover:text-white transition-all cursor-pointer shadow-sm"
                  >
                    Cargar más
                  </button>
                </div>
              )}
            </>
          ) : (
            <div class="rounded-xl border border-[#B45309]/25 bg-[#FFF8E7] p-12 text-center text-sm text-[#44403C]">
              No se encontraron pines en el RSS del tablero de Veyxara Studio en este momento.
            </div>
          )}
        </section>
      </div>
    </div>
  </main>

  <script>
    const setupPinterestLoadMore = () => {
      const btn = document.getElementById('load-more-pinterest-btn');
      if (!btn || btn.dataset.bound === 'true') return;
      btn.dataset.bound = 'true';

      const STEP = 12;
      const items = Array.from(document.querySelectorAll<HTMLElement>('.pinterest-block-item'));

      const syncButton = () => {
        if (!items.some((el) => el.classList.contains('hidden'))) {
          btn.classList.add('hidden');
        }
      };

      btn.addEventListener('click', () => {
        let shown = 0;
        for (const el of items) {
          if (el.classList.contains('hidden')) {
            el.classList.remove('hidden');
            shown += 1;
            if (shown >= STEP) break;
          }
        }
        syncButton();
      });

      syncButton();
    };

    document.addEventListener('DOMContentLoaded', setupPinterestLoadMore);
    document.addEventListener('astro:page-load', setupPinterestLoadMore);
  </script>
</StudioLayout>