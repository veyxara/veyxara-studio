---
// src/layouts/StudioLayout.astro
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Veyxara Studio — Arte Digital, Wallpapers & Colecciones Visuales',
  description = 'Vitrina creativa de arte digital, fondos de pantalla en alta definición y colecciones visuales.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-[#F6E7C6] text-[#1C1917] antialiased selection:bg-[#FF9900]/30 selection:text-[#1C1917]"
    style="background-color: #F6E7C6; color: #1C1917; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
  >
    <header class="sticky top-0 z-40 border-b border-[#B45309]/25 bg-[#EAD4A6]/95 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <span
            class="text-lg sm:text-xl font-extrabold tracking-wider text-[#1C1917] group-hover:text-[#C2410C] transition-colors"
            style="font-family: 'Orbitron', sans-serif;"
          >
            VEYXARA <span class="text-[#EA580C]">STUDIO</span>
          </span>
          <span class="hidden sm:inline-block text-[10px] font-mono font-bold uppercase px-2 py-0.5 rounded-full bg-[#FDE68A] border border-[#B45309]/45 text-[#78350F]">
            Visual Gallery
          </span>
        </a>

        <nav class="flex items-center gap-4 text-xs sm:text-sm shrink-0">
          <a href="#colecciones" class="font-semibold text-[#292524] hover:text-[#C2410C] transition-colors">
            Colecciones
          </a>
          <a
            href="https://veyxara.com"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-lg bg-[#FFF8E7] border border-[#D97706]/50 text-[#78350F] font-bold hover:bg-[#FF9900] hover:text-[#1C1917] transition-colors"
          >
            Veyxara Core ↗
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="border-t border-[#B45309]/25 bg-[#E7D1A2] py-8 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#44403C]">
        <p>
          <strong class="text-[#1C1917]" style="font-family: 'Orbitron', sans-serif;">VEYXARA STUDIO</strong> · Arte digital, wallpapers y piezas visuales.
        </p>
        <div class="flex items-center gap-5">
          <a href="https://www.pinterest.com/arevaloalfredo69/" target="_blank" rel="noopener noreferrer" class="font-semibold hover:text-[#C2410C] transition-colors">
            Pinterest
          </a>
          <a href="https://veyxara.com" target="_blank" rel="noopener noreferrer" class="font-semibold hover:text-[#C2410C] transition-colors">
            Portal Técnico (Core)
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>