---
// src/layouts/StudioLayout.astro
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Veyxara Studio — Arte Digital, Wallpapers & Colecciones Visuales',
  description = 'Vitrina creativa de arte digital, fondos de pantalla en alta definición y colecciones visuales.',
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body
    class="min-h-screen bg-[#FFFDF7] text-[#1E293B] antialiased selection:bg-[#FF9900]/25 selection:text-[#0F172A]"
    style="background-color: #FFFDF7; color: #1E293B; font-family: 'Plus Jakarta Sans', system-ui, sans-serif;"
  >
    <header class="sticky top-0 z-40 border-b border-[#FF9900]/25 bg-[#FFFDF7]/95 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <span
            class="text-lg sm:text-xl font-extrabold tracking-wider text-[#0F172A] group-hover:text-[#D97706] transition-colors"
            style="font-family: 'Orbitron', sans-serif;"
          >
            VEYXARA <span class="text-[#FF9900]">STUDIO</span>
          </span>
          <span class="hidden sm:inline-block text-[10px] font-mono uppercase px-2 py-0.5 rounded-full bg-[#FEF3C7] border border-[#D4AF37]/60 text-[#92400E]">
            Visual Gallery
          </span>
        </a>

        <nav class="flex items-center gap-4 text-xs sm:text-sm shrink-0">
          <a href="#colecciones" class="font-medium text-[#334155] hover:text-[#D97706] transition-colors">
            Colecciones
          </a>
          <a
            href="https://veyxara.com"
            target="_blank"
            rel="noopener noreferrer"
            class="px-3 py-1.5 rounded-lg bg-[#FEF3C7] border border-[#FF9900]/50 text-[#92400E] font-semibold hover:bg-[#FF9900] hover:text-[#0F172A] transition-colors"
          >
            Veyxara Core ↗
          </a>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="border-t border-[#FF9900]/20 bg-[#FFF8E7] py-8 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#475569]">
        <p>
          <strong class="text-[#0F172A]" style="font-family: 'Orbitron', sans-serif;">VEYXARA STUDIO</strong> · Arte digital, wallpapers y piezas visuales.
        </p>
        <div class="flex items-center gap-5">
          <a href="https://www.pinterest.com/arevaloalfredo69/" target="_blank" rel="noopener noreferrer" class="font-medium hover:text-[#D97706] transition-colors">
            Pinterest
          </a>
          <a href="https://veyxara.com" target="_blank" rel="noopener noreferrer" class="font-medium hover:text-[#D97706] transition-colors">
            Portal Técnico (Core)
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>