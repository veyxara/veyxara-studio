---
// src/components/WallpaperCard.astro
export interface Wallpaper {
  id: string;
  title: string;
  description?: string;
  category: string;
  resolution: string;
  aspectRatio: string;
  image: string;
  downloadUrl?: string;
  pinterestUrl?: string;
}

interface Props {
  wallpaper: Wallpaper;
  index?: number;
}

const { wallpaper, index = 0 } = Astro.props;

if (!wallpaper) {
  return null;
}

const normalizedCategory = wallpaper.category?.trim().toLowerCase() ?? '';
const isVertical =
  wallpaper.aspectRatio === '9:16' ||
  normalizedCategory === 'mobile' ||
  normalizedCategory === 'celular' ||
  wallpaper.aspectRatio === 'vertical';

const uniqueModalId = `modal-wallpaper-${index}-${wallpaper.id || 'item'}`;

const isBrand =
  wallpaper.category === 'Official Asset' ||
  wallpaper.category === 'Corporativa' ||
  normalizedCategory === 'official asset' ||
  normalizedCategory === 'corporativa';

const isPinterest =
  !isBrand &&
  (Boolean(wallpaper.pinterestUrl) || wallpaper.image?.includes('pinimg.com'));

const isLocalAsset = !isBrand && !isPinterest;
const targetUrl = wallpaper.pinterestUrl || wallpaper.image;
const downloadSource = wallpaper.downloadUrl || wallpaper.image;
const seoImageAlt = `${wallpaper.title} — Wallpaper ${wallpaper.resolution} | Veyxara Studio`;

const cardColors = {
  cardSurface: 'bg-[#EED9B5]',
  warmChip: 'bg-[#FAF6EE]',
  warmChipHover: 'hover:bg-[#FFFDF9]',
  pageBg: 'bg-[#FAF6EE]',
  inkPrimary: 'text-[#1C1917]',
  inkSecondary: 'text-[#44403C]',
  accentStrong: 'text-[#B45309]',
  accentDeep: 'text-[#92400E]',
  actionPrimaryBg: 'bg-[#292524]',
  actionPrimaryHover: 'hover:bg-[#1C1917]',
  borderLight: 'border-[#B45309]/25',
  borderMedium: 'border-[#B45309]/55',
};
---

<article class="wallpaper-card group">
  <div
    class:list={[
      'card-media-wrapper cursor-pointer preview-trigger',
      { 'is-vertical': isVertical },
    ]}
    data-modal-target={uniqueModalId}
  >
    <img
      src={wallpaper.image}
      alt={seoImageAlt}
      loading="lazy"
      decoding="async"
      oncontextmenu={isBrand ? 'return false;' : undefined}
      class="w-full h-full object-contain object-center transition-all duration-700 ease-out group-hover:scale-105"
    />

    <span
      class:list={[
        'absolute top-3 right-3 border text-[10px] font-mono font-bold px-2 py-1 rounded-md shadow-xs z-10 whitespace-nowrap',
        cardColors.pageBg,
        cardColors.borderMedium,
        cardColors.accentDeep,
      ]}
    >
      {wallpaper.resolution}
    </span>

    <div
      class="absolute inset-0 bg-[#1C1917]/60 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center gap-2"
    >
      <span
        class:list={[
          'text-[#FFFDF9] text-xs font-bold px-3 py-1.5 rounded-lg flex items-center gap-1.5 shadow-lg whitespace-nowrap border border-[#FAF6EE]/20',
          cardColors.actionPrimaryBg,
        ]}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-4 w-4 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
          />
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
          />
        </svg>
        Inspeccionar / Previsualizar
      </span>
    </div>
  </div>

  <div class:list={['p-5 flex flex-col justify-between flex-grow', cardColors.cardSurface]}>
    <div>
      <span
        class:list={[
          'text-xs font-mono font-bold uppercase tracking-wider',
          cardColors.accentStrong,
        ]}
      >
        CATEGORÍA: {wallpaper.category}
      </span>
      <h3
        class:list={[
          'text-base font-bold mt-1 group-hover:text-[#92400E] transition-colors',
          cardColors.inkPrimary,
        ]}
      >
        {wallpaper.title}
      </h3>
      {wallpaper.description && (
        <p
          class:list={[
            'text-xs mt-1.5 leading-relaxed line-clamp-2',
            cardColors.inkSecondary,
          ]}
        >
          {wallpaper.description}
        </p>
      )}
    </div>

    <div
      class:list={[
        'mt-6 pt-4 border-t flex flex-wrap items-center justify-between gap-2',
        cardColors.borderLight,
      ]}
    >
      <button
        type="button"
        class:list={[
          'preview-trigger text-xs hover:text-[#1C1917] font-mono font-semibold transition-colors flex items-center gap-1 cursor-pointer whitespace-nowrap',
          cardColors.inkSecondary,
        ]}
        data-modal-target={uniqueModalId}
      >
        <span aria-hidden="true">🔍</span>
        <span>Ampliar Arte</span>
      </button>

      {isPinterest && (
        <a
          href={targetUrl}
          target="_blank"
          rel="noopener noreferrer"
          class:list={[
            'inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border text-xs font-bold hover:bg-[#292524] hover:text-[#FFFDF9] hover:border-[#292524] transition-all cursor-pointer shadow-xs whitespace-nowrap',
            cardColors.warmChip,
            cardColors.borderMedium,
            cardColors.inkPrimary,
          ]}
        >
          <span>Ir a Pinterest</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-3.5 w-3.5 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
            />
          </svg>
        </a>
      )}

      {isLocalAsset && (
        <button
          type="button"
          class:list={[
            'download-btn inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-[#FFFDF9] text-xs font-bold transition-all cursor-pointer shadow-xs whitespace-nowrap',
            cardColors.actionPrimaryBg,
            cardColors.actionPrimaryHover,
          ]}
          data-image={downloadSource}
          data-title={wallpaper.title}
        >
          <span>Descargar JPG</span>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-3.5 w-3.5 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
            />
          </svg>
        </button>
      )}

      {isBrand && (
        <span
          class:list={[
            'text-xs font-mono font-semibold italic whitespace-nowrap',
            cardColors.accentDeep,
          ]}
        >
          Solo marca
        </span>
      )}
    </div>
  </div>

  <dialog
    id={uniqueModalId}
    class="wallpaper-modal p-0 rounded-2xl bg-transparent w-full max-w-7xl"
  >
    <div
      class:list={[
        'relative w-full h-[95vh] border rounded-2xl p-4 md:p-6 overflow-hidden flex flex-col items-center shadow-2xl',
        cardColors.cardSurface,
        cardColors.borderMedium,
        cardColors.inkPrimary,
      ]}
    >
      <div
        class:list={[
          'w-full flex items-center justify-between mb-3 pb-2 border-b shrink-0',
          cardColors.borderLight,
        ]}
      >
        <div>
          <p class:list={['text-base md:text-lg font-bold', cardColors.inkPrimary]}>
            {wallpaper.title}
          </p>
          {wallpaper.description && (
            <p class:list={['text-xs mt-0.5', cardColors.inkSecondary]}>
              {wallpaper.description}
            </p>
          )}
          <span
            class:list={[
              'text-xs font-mono font-semibold',
              cardColors.accentStrong,
            ]}
          >
            {wallpaper.resolution} • {wallpaper.category}
          </span>
        </div>

        <form method="dialog">
          <button
            class:list={[
              'px-3 py-1.5 hover:text-[#1C1917] border rounded-lg transition-colors cursor-pointer text-sm font-bold whitespace-nowrap shrink-0',
              cardColors.warmChip,
              cardColors.borderMedium,
              cardColors.inkSecondary,
            ]}
          >
            ✕ Cerrar
          </button>
        </form>
      </div>

      <div
        class:list={[
          'relative overflow-auto flex-grow w-full flex items-center justify-center rounded-xl p-2 border',
          cardColors.pageBg,
          cardColors.borderLight,
        ]}
      >
        <img
          src={wallpaper.image}
          data-src={wallpaper.image}
          alt={seoImageAlt}
          loading="lazy"
          decoding="async"
          oncontextmenu={isBrand ? 'return false;' : undefined}
          class={`modal-img max-h-full max-w-full w-auto h-auto object-contain rounded-lg shadow-md ${
            isBrand ? 'select-none pointer-events-none' : ''
          }`}
        />
      </div>

      <div
        class:list={[
          'w-full mt-3 pt-2 border-t flex items-center justify-between gap-4 shrink-0',
          cardColors.borderLight,
        ]}
      >
        <span class:list={['text-xs font-mono', cardColors.inkSecondary]}>
          {isPinterest
            ? 'Repositorio externo: Encuentra este diseño en nuestro tablero oficial de Veyxara Studio en Pinterest.'
            : isBrand
              ? 'Activo de identidad de marca protegido (descarga deshabilitada).'
              : `Optimizado para ${wallpaper.resolution}.`}
        </span>

        {isPinterest && (
          <a
            href={targetUrl}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              'px-5 py-2 rounded-xl text-[#FFFDF9] font-bold text-sm transition-all flex items-center gap-2 cursor-pointer shadow-sm whitespace-nowrap shrink-0',
              cardColors.actionPrimaryBg,
              cardColors.actionPrimaryHover,
            ]}
          >
            <span>Ir a Pinterest</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
              />
            </svg>
          </a>
        )}

        {isLocalAsset && (
          <button
            type="button"
            class:list={[
              'download-btn px-5 py-2 rounded-xl text-[#FFFDF9] font-bold text-sm transition-all flex items-center gap-2 cursor-pointer shadow-sm whitespace-nowrap shrink-0',
              cardColors.actionPrimaryBg,
              cardColors.actionPrimaryHover,
            ]}
            data-image={downloadSource}
            data-title={wallpaper.title}
          >
            <span>Descargar en Alta Resolución (JPG)</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-4 w-4 shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
              />
            </svg>
          </button>
        )}

        {isBrand && (
          <form method="dialog">
            <button
              class:list={[
                'px-4 py-2 rounded-xl border font-bold text-sm transition-all cursor-pointer whitespace-nowrap shrink-0',
                cardColors.warmChip,
                cardColors.warmChipHover,
                cardColors.borderMedium,
                cardColors.accentDeep,
              ]}
            >
              Cerrar Vista Previa
            </button>
          </form>
        )}
      </div>
    </div>
  </dialog>
</article>

<script>
  const DOWNLOAD_MIME_TYPE: 'image/jpeg' | 'image/png' = 'image/jpeg';
  const DOWNLOAD_EXTENSION = DOWNLOAD_MIME_TYPE === 'image/png' ? 'png' : 'jpg';

  const notifyTelegramStudio = (title: string, action: string) => {
    fetch('/api/studio-notify', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        title: title || 'Wallpaper Veyxara Studio',
        action,
        url: window.location.href,
      }),
    }).catch((err) => {
      console.error('[Telegram Studio Notify]', err);
    });
  };

  const inferExtension = (url: string, mimeType?: string): string => {
    if (mimeType?.includes('webp')) return 'webp';
    if (mimeType?.includes('png')) return 'png';
    if (mimeType?.includes('jpeg') || mimeType?.includes('jpg')) return 'jpg';
    const cleanUrl = url.split('?')[0]?.toLowerCase() ?? '';
    const match = cleanUrl.match(/\.(webp|png|jpe?g)$/);
    if (!match) return 'webp';
    return match[1] === 'jpeg' ? 'jpg' : match[1];
  };

  const triggerDownload = (href: string, fileName: string, revokeAfter = false) => {
    const link = document.createElement('a');
    link.href = href;
    link.download = fileName;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    if (revokeAfter) {
      setTimeout(() => URL.revokeObjectURL(href), 1000);
    }
  };

  const setupWallpaperCards = () => {
    document.querySelectorAll('.preview-trigger').forEach((trigger) => {
      if (trigger.hasAttribute('data-initialized')) return;
      trigger.setAttribute('data-initialized', 'true');

      trigger.addEventListener('click', () => {
        const modalId = trigger.getAttribute('data-modal-target');
        if (!modalId) return;

        const modal = document.getElementById(modalId) as HTMLDialogElement | null;
        if (!modal) return;

        const modalImg = modal.querySelector('.modal-img') as HTMLImageElement | null;
        if (modalImg && modalImg.dataset.src && !modalImg.getAttribute('src')) {
          modalImg.src = modalImg.dataset.src;
        }
        modal.showModal();
      });
    });

    document.querySelectorAll('.download-btn').forEach((btn) => {
      if (btn.hasAttribute('data-initialized')) return;
      btn.setAttribute('data-initialized', 'true');

      btn.addEventListener('click', async () => {
        const imageSrc = btn.getAttribute('data-image');
        const wallpaperTitle = btn.getAttribute('data-title');

        if (!imageSrc) return;

        notifyTelegramStudio(wallpaperTitle || 'Wallpaper', 'Descarga JPG');

        const safeName =
          wallpaperTitle
            ?.toLowerCase()
            .replace(/[^a-z0-9]+/g, '-')
            .replace(/^-|-$/g, '') || 'veyxara-wallpaper';

        try {
          const response = await fetch(imageSrc);
          if (!response.ok) throw new Error('Network response not ok');
          const blob = await response.blob();
          const objectUrl = URL.createObjectURL(blob);

          const img = new Image();
          img.decoding = 'async';
          img.src = objectUrl;

          await new Promise<void>((resolve, reject) => {
            img.onload = () => resolve();
            img.onerror = () => reject(new Error('Image decode error'));
          });

          const canvas = document.createElement('canvas');
          canvas.width = img.naturalWidth;
          canvas.height = img.naturalHeight;
          const ctx = canvas.getContext('2d');

          if (!ctx) throw new Error('Canvas 2D unavailable');

          if (DOWNLOAD_MIME_TYPE === 'image/jpeg') {
            ctx.fillStyle = '#071426';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
          }

          ctx.drawImage(img, 0, 0);
          URL.revokeObjectURL(objectUrl);

          const convertedBlob = await new Promise<Blob | null>((resolve) =>
            canvas.toBlob(
              resolve,
              DOWNLOAD_MIME_TYPE,
              DOWNLOAD_MIME_TYPE === 'image/jpeg' ? 0.95 : undefined
            )
          );

          if (!convertedBlob) throw new Error('Canvas toBlob failed');

          const convertedUrl = URL.createObjectURL(convertedBlob);
          triggerDownload(convertedUrl, `${safeName}.${DOWNLOAD_EXTENSION}`, true);
        } catch {
          const realExt = inferExtension(imageSrc);
          triggerDownload(imageSrc, `${safeName}.${realExt}`, false);
        }
      });
    });
  };

  document.addEventListener('DOMContentLoaded', setupWallpaperCards);
  document.addEventListener('astro:page-load', setupWallpaperCards);
</script>

<style>
  .wallpaper-card {
    background-color: #EED9B5;
    border: 1px solid rgba(180, 83, 9, 0.45);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px -2px rgba(180, 83, 9, 0.12);
    transition: all 0.25s ease-in-out;
  }
  .card-media-wrapper {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background-color: #E4C99E;
  }
  .card-media-wrapper.is-vertical {
    aspect-ratio: 9 / 16;
  }
  .wallpaper-card:hover {
    border-color: rgba(180, 83, 9, 0.85);
    transform: translateY(-4px);
    box-shadow: 0 12px 24px -6px rgba(180, 83, 9, 0.2);
  }
  body:has(dialog.wallpaper-modal[open]) {
    overflow: hidden;
  }
  dialog.wallpaper-modal {
    margin: auto;
    max-height: 95vh;
    animation: fadeIn 0.2s ease-out forwards;
  }
  dialog.wallpaper-modal[open] {
    display: flex;
    flex-direction: column;
  }
  dialog.wallpaper-modal::backdrop {
    background: rgba(28, 25, 23, 0.65);
    backdrop-filter: blur(8px);
    position: fixed;
    inset: 0;
  }
  @keyframes fadeIn {
    from { opacity: 0; transform: scale(0.95); }
    to { opacity: 1; transform: scale(1); }
  }
</style>